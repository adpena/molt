#!/usr/bin/env bash
# molt-drift-gate-hook v2  (managed by tools/install_git_hooks.py — do not rename this marker)
# Drift enforcement gate (P0). Worktree/branch sprawl and aged unlanded SIGNAL are
# POISON — a 165-branch OneDrive .git had to be retired 2026-07-08. This blocks a
# push when drift has accumulated so it MUST be harvested onto main and pruned.
# False positives are acceptable (operator directive) — a red gate means "harvest
# + prune now", which is always correct hygiene. Override for a genuine emergency
# with MOLT_SKIP_DRIFT_GATE=1 git push ...
set -uo pipefail

if [ "${MOLT_SKIP_DRIFT_GATE:-}" = "1" ]; then
  echo "pre-push: drift gate skipped (MOLT_SKIP_DRIFT_GATE=1)"
  exit 0
fi

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
gate="$repo_root/tools/drift_harvest.py"
launch="$repo_root/.githooks/molt-hook-launch.sh"
[ -f "$gate" ] && [ -f "$launch" ] || exit 0
# shellcheck source=molt-hook-launch.sh
. "$launch" || exit 1

# --no-fetch: the push already contacts origin; skip a redundant/hang-prone
# fetch inside the hook. A stale origin/main only risks a benign false positive.
if ! molt_hook_uv_python pre-push "$gate" --gate --no-fetch; then
  echo ""
  echo "pre-push BLOCKED by drift gate. Harvest SIGNAL onto origin/main (use 3-way"
  echo "git merge/merge-tree, not git cherry) and prune landed/superseded worktrees:"
  echo "  python tools/drift_harvest.py --prune"
  echo "Emergency override: MOLT_SKIP_DRIFT_GATE=1 git push ..."
  exit 1
fi
exit 0
