{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${CLAUDE_PROJECT_DIR}/tools/hooks/run.sh\" ] || exit 1; sh \"${CLAUDE_PROJECT_DIR}/tools/hooks/run.sh\" session_digest",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${CLAUDE_PROJECT_DIR}/tools/hooks/run.sh\" ] || exit 1; sh \"${CLAUDE_PROJECT_DIR}/tools/hooks/run.sh\" bash_guard",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${CLAUDE_PROJECT_DIR}/tools/hooks/run.sh\" ] || exit 1; sh \"${CLAUDE_PROJECT_DIR}/tools/hooks/run.sh\" stop_gates",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
