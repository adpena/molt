# One checkout representation for every text authority. Generated freshness,
# source digests, reproducible builds, and tests must see the same bytes on
# Windows, macOS, and Linux regardless of the user's core.autocrlf setting.
* text=auto eol=lf

# Preserve the complete upstream license, including its final blank line.
vendor/rust/cranelift-object/LICENSE whitespace=-blank-at-eof

# Native command scripts are the only text family whose consumer requires the
# Windows line-ending convention.
*.bat text eol=crlf
*.cmd text eol=crlf

# Preserved handoff WIP: patch context lines carry their source whitespace verbatim.
docs/agent/handoff-patches/*.patch -whitespace

# Published compression corpus files are byte inputs, including the PDF fixture.
vendor/rust/zlib-rs/src/deflate/test-data/* binary

# Retain the original upstream license bytes, including its copyright spacing.
vendor/rust/zlib-rs/LICENSE whitespace=-blank-at-eof,-blank-at-eol

# The v1.0 ledger merges findings rows by ID (tools/ledger_merge.py, installed
# by tools/install_git_hooks.py); without the driver Git merges it as text.
docs/agent/V1_HANDOFF_FINDINGS.md merge=molt-ledger
