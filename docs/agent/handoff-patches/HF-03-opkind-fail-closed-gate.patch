+pub(crate) fn validate_op_kinds(function_name: &str, ops: &[OpIR]) -> Result<(), String> {
+    for (op_index, op) in ops.iter().enumerate() {
+        ir_schema::validate_op_not_retired(&op.kind)
+            .map_err(|error| format!("function `{function_name}` op#{op_index}: {error}"))?;
+        if !simpleir_kind_is_registered(&op.kind) {
+            return Err(format!(
+                "function `{function_name}` op#{op_index}: unregistered op kind `{}`",
+                op.kind
+            ));
+        }
+    }
+    Ok(())
+}
