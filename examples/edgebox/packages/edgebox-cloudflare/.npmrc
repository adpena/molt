; Release-age rule (docs/DEVELOPER_GUIDE.md): npm resolves only releases
; published at least 7 days ago. tools/pin_freshness.py --check holds this
; file to the rule and fails once an exemption below has aged out.
min-release-age=7
; exempt @cloudflare/workers-types@5.20261022.1 until 2026-10-29T01:26:16Z, range ^5.20261022.1 (HF-62): adopted in a9f61e4f3 before the rule landed
min-release-age-exclude[]=@cloudflare/workers-types
