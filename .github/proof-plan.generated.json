      "python3 tools/venv_exec.py python tools/check_rustfmt.py --changed"
    ],
    "rules": [
      {
        "description": "Cranelift/native backend Rust: clippy + backend lib tests, fresh binary.",
        "gates": [
          "cargo clippy -p molt-backend --features native-backend -- -D warnings",
          "cargo test --profile release-fast -p molt-backend --features native-backend --lib"
        ],
        "globs": [
          "runtime/molt-backend/**/*.rs",
          "runtime/molt-backend/**/Cargo.toml"
        ],
        "name": "backend-native",
        "require_fresh_toolchain": true
      },
      {
        "description": "LLVM backend Rust: clippy + LLVM-feature lib tests.",
        "gates": [
          "cargo test --profile release-fast -p molt-backend-native --features llvm --lib"
        ],
        "globs": [
          "runtime/molt-backend-native/Cargo.toml",
          "runtime/molt-backend-native/src/llvm_backend/**/*.rs"
        ],
        "name": "backend-llvm",
        "require_fresh_toolchain": true
      },
      {
        "description": "TIR midend Rust: all-target clippy + feature-complete tests.",
        "gates": [
          "cargo clippy -p molt-passes --all-targets --all-features -- -D warnings",
          "cargo test -p molt-passes --all-features --no-fail-fast",
          "cargo clippy -p molt-tir --all-targets --all-features -- -D warnings",
          "cargo test -p molt-tir --all-features --no-fail-fast"
        ],
        "globs": [
          "runtime/molt-ir/**/*.rs",
          "runtime/molt-ir/**/*.toml",
          "runtime/molt-ir/Cargo.toml",
          "runtime/molt-passes/**/*.rs",
          "runtime/molt-passes/**/*.toml",
          "runtime/molt-passes/Cargo.toml",
          "runtime/molt-tir/**/*.rs",
          "runtime/molt-tir/**/*.toml",
          "runtime/molt-tir/Cargo.toml"
        ],
        "name": "tir-midend",
        "require_fresh_toolchain": true
      },
      {
        "description": "Wasmtime host Rust: warning-free clippy + release-fast link build.",
        "gates": [
          "cargo clippy -p molt-wasm-host -- -D warnings",
          "cargo build --profile release-fast -p molt-wasm-host"
        ],
        "globs": [
          "runtime/molt-wasm-host/**/*.rs",
          "runtime/molt-wasm-host/**/*.toml",
          "runtime/molt-wasm-host/Cargo.toml"
        ],
        "name": "wasm-host",
        "require_fresh_toolchain": true
      },
      {
        "description": "GPU acceleration Rust: all-target/all-feature clippy for FFI and renderer surfaces.",
        "gates": [
          "cargo clippy -p molt-gpu --all-targets --all-features -- -D warnings"
        ],
        "globs": [
          "runtime/molt-gpu/**/*.rs",
          "runtime/molt-gpu/**/*.toml",
          "runtime/molt-gpu/Cargo.toml"
        ],
        "name": "runtime-gpu"
      },
      {
        "description": "Runtime VFS satellite crate: all-target clippy, feature coverage, and browser adapter smoke.",
        "gates": [
          "cargo clippy -p molt-runtime-vfs --all-targets --all-features -- -D warnings",
          "cargo test -p molt-runtime-vfs --all-features --no-fail-fast",
          "python3 -m pytest tests/test_browser_vfs.py -q"
        ],
        "globs": [
          "runtime/molt-runtime-vfs/**/*.rs",
          "runtime/molt-runtime-vfs/Cargo.toml",
          "tests/test_browser_vfs.py",
          "wasm/molt_vfs_browser.js"
        ],
        "name": "runtime-vfs",
        "require_fresh_toolchain": true
      },
      {
        "description": "Runtime/object-model Rust: runtime lib tests + clippy, fresh binary.",
        "gates": [
          "cargo test --profile release-fast -p molt-runtime --lib",
          "cargo clippy -p molt-backend --features native-backend -- -D warnings"
        ],
        "globs": [
          "runtime/molt-runtime/**/*.rs",
          "runtime/molt-obj-model/**/*.rs",
          "runtime/**/Cargo.toml"
        ],
        "name": "runtime-lib",
        "require_fresh_toolchain": true
      },
      {
